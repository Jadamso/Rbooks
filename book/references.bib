@article{Spiegler2022,
title = {On the behavioral consequences of reverse causality},
journal = {European Economic Review},
volume = {149},
pages = {104258},
year = {2022},
issn = {0014-2921},
doi = {https://doi.org/10.1016/j.euroecorev.2022.104258},
url = {https://www.sciencedirect.com/science/article/pii/S0014292122001520},
author = {Ran Spiegler},
keywords = {Reverse causality, Bayesian networks, Causal models, Non-rational expectations},
abstract = {Reverse causality is a common attribution error that distorts the evaluation of private actions and public policies. This paper explores the implications of this error when a decision maker acts on it and therefore affects the very statistical regularities from which he draws faulty inferences. Applying the Bayesian-network approach of Spiegler (2016), I explore the equilibrium effects of a certain class of reverse-causality errors, in the context of an example with a quadratic-normal parameterization. I show that the decision context may protect the decision maker from his own reverse-causality error. That is, the cost of reverse-causality errors can be lower for everyday decision makers than for an outside observer who evaluates their choices.}
}

