@Article{Adamson2022_Greece,
  author   = {Adamson, Jordan},
  journal  = {SSRN},
  title    = {Trade and the Rise of The Ancient Greek City-States},
  year     = {2021},
  abstract = {In this paper, I synthesize neo-institutionalist, neo-physiocrat, and neo-classical theories of development into a unified comparative advantage model. Then, with a new dataset on ancient Greece and the natural environment, I examine a main empirical prediction that the potential crop diversity of neighboring city-states is important for production, appropriation, and defense. An exploratory analysis of the ancient Greek city-states suggests that potential crop diversity is fundamental for explaining economic, military, and political development. Nonparametric tests confirm that potential crop diversity variables are statistically significant and not the abundance of other factors previously emphasized.},
