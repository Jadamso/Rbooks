@article{Clark2008,
	author = {Clark, William A. V. and Fossett, Mark},
	title = {Understanding the social context of the Schelling segregation model},
	volume = {105},
	number = {11},
	pages = {4109--4114},
	year = {2008},
	doi = {10.1073/pnas.0708155105},
	publisher = {National Academy of Sciences},
	abstract = {A recent article [Vinkovic D, Kirman A (2006) Proc Natl Acad Sci USA 103:19261{\textendash}19265] showing that the Schelling model has a physical analogue extends our understanding of the model. However, prior research has already outlined a mathematical basis for the Schelling model and simulations based on it have already enhanced our understanding of the social dynamics that underlie the model, something that the physical analogue does not address. Research in social science has provided a formal basis for the segregative outcomes resulting from the residential selection process and simulations have replicated relevant spatial outcomes under different specifications of the residential dynamics. New and increasingly detailed survey data on preferences demonstrates the embeddedness of the Schelling selection process in the social behaviors of choosing alternative residential compositions. It also demonstrates that, in the multicultural context, seemingly mild preferences for living with similar neighbors carry the potential to be strong determinants for own race selectivity and residential segregation.},
	issn = {0027-8424},
	URL = {https://www.pnas.org/content/105/11/4109},
	eprint = {https://www.pnas.org/content/105/11/4109.full.pdf},
	journal = {Proceedings of the National Academy of Sciences}
}

@article{Clarke2005,
