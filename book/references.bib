@article{BickelSakov2008,
 ISSN = {10170405, 19968507},
 URL = {http://www.jstor.org/stable/24308525},
 abstract = {For i.i.d. samples of size n, the ordinary bootstrap (Efron (1979)) is known to be consistent in many situations, but it may fail in important examples (Bickel, Götze and van Zwet (1997)). Using bootstrap samples of size m, where m → ∞ and m/n → 0, typically resolves the problem (Bickel et al. (1997), Politis and Romano (1994)). The choice of m is a key issue. In this paper, we consider an adaptive rule, proposed by Bickel, Götze, and van Zwet (personal communication), to pick m. We give general sufficient conditions for first order validity of the rule, and consider its higher order behavior when the ordinary bootstrap fails, and when it works. We then examine the behavior of the rule in the context of setting confidence bounds on high percentiles, such as the asymptotic expected maximum.},
 author = {Peter J. Bickel and Anat Sakov},
 journal = {Statistica Sinica},
 number = {3},
 pages = {967--985},
 publisher = {Institute of Statistical Science, Academia Sinica},
 title = {On the choice of m in the m out of n Bootstrap and confidence bounds for extrema},
 urldate = {2023-04-08},
 volume = {18},
 year = {2008}
}

@TechReport{	  biddle2016,
  title		= "Theory and Measurement: Emergence, Consolidation and
		  Erosion of a Consensus",
  author	= "Biddle, Jeff E and Hamermesh, Daniel S",
  institution	= "National Bureau of Economic Research",
  type		= "Working Paper",
  series	= "Working Paper Series",
  number	= "22253",
  year		= "2016",
  month		= "May",
  doi		= {10.3386/w22253},
  url		= "http://www.nber.org/papers/w22253",
  abstract	= {We identify three separate stages in the post-World War II
		  history of applied microeconomic research: A generally
		  non-mathematical period; a period of consensus (from the
		  1960s through the early 1990s) characterized by the use of
		  mathematical models, optimization and equilibrium to
		  generate and test hypotheses about economic behavior; and
		  (from the late 1990s) a partial abandonment of economic
		  theory in applied work in the "experimentalist
		  paradigm." We document the changes implied by the
		  changing paradigms in the profession by coding the content
		  of all applied micro articles published in the "Top 5
		  journals" in 1951-55, 1974-75 and 2007-08. We also show
		  that, despite the partial abandonment of theory by applied
		  microeconomists, the labor market for economists still pays
		  a wage premium to theorists.}
}

