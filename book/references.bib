@Article{	  friedmanschwarz1991,
  issn		= {00028282},
  url		= {http://www.jstor.org/stable/2006787},
  abstract	= {This paper compares two approaches to the analysis of
		  economic data: the exclusively econometric approach
		  recommended by Hendry and Ericsson and the more eclectic
		  approach that we employed in our books Monetary History and
		  Monetary Trends. It concludes that the article by Hendry
		  and Ericsson is mislabeled. Their article is not in any
		  relevant sense an evaluation of our "empirical model of
		  U.K. money demand." Rather, it uses one equation from our
		  book as a peg on which to hang an exposition of
		  sophisticated econometric techniques. Insofar as their
		  empirical findings do bear on ours, they simply confirm
