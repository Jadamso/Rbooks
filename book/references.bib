@techreport{Buncic2025,
author={Buncic, Daniel, Simplified: A Closer Look at the Virtue of Complexity in Return Prediction},
month={4},
day={30},
year={2025},
url={https://ssrn.com/abstract=5239006},
abstract={When all you need is an intercept term ...  Kelly, Malamud and Zhou (2024, KMZ) argue that simple models severely understate return predictability relative to complex ones in which the number of predictors vastly exceeds the number of observations used to train the models. They call this the ‘Virtue of Complexity’ (VoC). This paper re-examines KMZ’s empirical VoC results and shows that their key finding that portfolio performance is strictly increasing in model complexity is the consequence of a user-imposed zero- intercept restriction and a paradoxical aggregation scheme used in the construction of the complex model’s performance measures. Allowing for a non-zero intercept term leads to an increase in portfolio performance as the training window size increases for all levels of ridge shrinkage and number of predictors considered. This is synonymous with an increase in performance given a decrease in model complexity — exactly opposite to KMZ’s VoC claim. The complex model’s praised long-only strategy is also due to the zero-intercept restriction and disappears entirely once a constant term is allowed for. Much simpler linear models with only 15 predictor variables and mild ridge shrinkage substantially outperform KMZ’s proposed complex model.}
}

@article{BusoEtAl2021,
author={Buso, Irene Maria and Di Cagno, Daniela and Ferrari, Lorenzo and Larocca, Vittorio and Lorè, Luisa and Marazzi, Francesca and Panaccione, Luca and Spadoni, Lorenzo},
year={2021},
month={12},
day={01},
Title={Lab-like findings from online experiments},
Journal={Journal of the Economic Science Association},
pages={184--193},
volume={7},
Issue={2},
abstract={Laboratory experiments have been often replaced by online experiments in the last decade. This trend has been reinforced when academic and research work based on physical interaction had to be suspended due to restrictions imposed to limit the spread of Covid-19. Therefore, data quality and results from web experiments have become an issue which is currently investigated. Are there significant differences between lab experiments and online findings? We contribute to this debate via an experiment aimed at comparing results from a novel online protocol with traditional laboratory settings, using the same pool of participants. We find that participants in our experiment behave in a similar way across settings and that there are at best weakly significant and quantitatively small differences in behavior observed using our online protocol and physical laboratory setting.},
ISSN={2199-6776},
URL={https://doi.org/10.1007/s40881-021-00114-8},
DOI={10.1007/s40881-021-00114-8}
}

